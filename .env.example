# Copy this file to .env.local (git-ignored) and fill in real values.
# These are your Supabase project's PUBLIC anon key + URL, used by the
# browser app. They are safe to expose to the client ONLY because Row
# Level Security (RLS) policies restrict what that key can actually do
# server-side -- see src/services/db.ts SQL_SCHEMA. Do not disable RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used server-side only by api/doc.js and api/whatsapp.js (Vercel serverless functions).
# Set these in Vercel Project Settings -> Environment Variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret, required to verify incoming webhook signatures. Server-only.
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Bizylead WhatsApp Messaging API credentials
BIZYLEAD_API_KEY=c6a02de1ededcd12342b6302ec4b052f76eb83f273994a4606fa070333a0a1ce
BIZYLEAD_PHONE_NUMBER_ID=982427143955673
BIZYLEAD_BASE_URL=https://app.bizylead.com/api/v2/whatsapp-business

